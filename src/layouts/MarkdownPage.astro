---
import { getEntry, render } from 'astro:content';
import Base from './Base.astro';

interface Props {
  /** File name in src/content/pages without .md */
  id: string;
}
const page = await getEntry('pages', Astro.props.id);
if (!page) throw new Error(`Missing src/content/pages/${Astro.props.id}.md`);
const { Content } = await render(page);
---

<Base title={page.data.title} description={page.data.description}>
  <header class="page-head">
    <h1>{page.data.title}</h1>
    {page.data.description && <p>{page.data.description}</p>}
  </header>
  <div class="prose">
    <Content />
  </div>
</Base>
