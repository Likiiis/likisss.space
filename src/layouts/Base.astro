---
import '@fontsource-variable/raleway';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { SITE, NAV, SOCIALS } from '../config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const { title, description = SITE.description, image } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.shortTitle}` : `${SITE.shortTitle} — ${SITE.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
// posts with a `cover:` use it; everything else gets the generic card (scripts/og/render.sh)
const ogImage = new URL(image ?? '/og-default.png', Astro.site).href;
const isActive = (href: string) =>
  href === '/' ? path === '/' || path.startsWith('/posts/') || path.startsWith('/tags/') : path.startsWith(href);
const socials = SOCIALS.filter((s) => s.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- link previews (Messenger, WhatsApp, iMessage, Discord, X, LinkedIn) -->
    <meta property="og:site_name" content={SITE.shortTitle} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={title ? 'article' : 'website'} />
    <meta property="og:image" content={ogImage} />
    {
      !image && (
        <>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }
    <meta property="og:image:alt" content={title ?? SITE.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? SITE.title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#f3f4f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1117" media="(prefers-color-scheme: dark)" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-row">
        <a href="/" class="site-title">
          <svg class="logo" viewBox="0 0 32 32" aria-hidden="true">
            <ellipse cx="16" cy="16" rx="14.5" ry="5.2" fill="none" stroke="currentColor" stroke-width="1.6" opacity=".55" transform="rotate(-20 16 16)" />
            <circle cx="16" cy="16" r="7.5" fill="currentColor" />
            <path d="M2.4 20.9 A14.5 5.2 -20 0 0 29.6 11.1" fill="none" stroke="currentColor" stroke-width="1.6" />
          </svg>
          {SITE.title}
        </a>
        {
          socials.length > 0 && (
            <ul class="socials">
              {socials.map((s) => (
                <li>
                  <a href={s.url} rel="me noopener" target="_blank" aria-label={s.label} title={s.label}>
                    <Icon name={s.icon} />
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
      <nav class="wrap nav" aria-label="Main">
        {
          NAV.map((item) => (
            <a href={item.href} class:list={{ active: isActive(item.href) }} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        {new Date().getFullYear()} © {SITE.shortTitle}
      </div>
    </footer>
  </body>
</html>
