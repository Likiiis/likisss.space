---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, tagSlug, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const byTag = new Map<string, { name: string; posts: Post[] }>();
  for (const post of posts) {
    for (const name of post.data.tags) {
      const slug = tagSlug(name);
      if (!byTag.has(slug)) byTag.set(slug, { name, posts: [] });
      byTag.get(slug)!.posts.push(post);
    }
  }
  return [...byTag].map(([tag, { name, posts }]) => ({ params: { tag }, props: { name, posts } }));
}

interface Props {
  name: string;
  posts: Post[];
}
const { name, posts } = Astro.props;
---

<Base title={`#${name}`} description={`Posts tagged “${name}”.`}>
  <header class="page-head">
    <div class="breadcrumbs"><a href="/">Posts</a> / tag</div>
    <h1>#{name}</h1>
    <p>{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
  </header>
  <ul class="post-list">
    {posts.map((post) => <PostCard post={post} />)}
  </ul>
</Base>
